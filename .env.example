# App runtime
APP_NAME=Remote Command Plot API
APP_DESCRIPTION=For AS Watson GIT Use only
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=3
LOG_JSON=0

# Session management
SESSION_TTL_SECONDS=300
CLEANER_INTERVAL_SECONDS=60

# SSH behavior
SSH_CONNECT_TIMEOUT=20
SSH_KEEPALIVE_SECONDS=30
SSH_READY_TIMEOUT=6
COMMAND_MAX_LENGTH=4096
